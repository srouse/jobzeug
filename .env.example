OPENAI_API_KEY=
DATABASE_URL=
# Optional: set to true if your provider needs TLS with rejectUnauthorized=false
# (sslmode in DATABASE_URL is normalized to verify-full to silence pg warnings)
# DATABASE_SSL=true

# Site-wide password gate (required for Next app; fail closed if missing)
SITE_PASSWORD=
SESSION_SECRET=

# Contentful CMA (evidence compress → Employer / Role / Project sync)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_MANAGEMENT_TOKEN=
# Contentful CDA (app read path — /api/resume and future SPA surfaces)
CONTENTFUL_DELIVERY_TOKEN=


# Firecrawl (job listing scrape + Design-tab brand site resolve/branding)
FIRECRAWL_API_KEY=
