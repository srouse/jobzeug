{
  "name": "jobzeug",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:studio": "mastra dev",
    "dev:all": "concurrently -n next,studio -c blue,magenta \"next dev\" \"mastra dev\"",
    "ds:build": "npm run build -w @jobzeug/design-system",
    "ds:dev": "npm run dev -w @jobzeug/design-system",
    "ds2": "npm run ds2 -w @jobzeug/design-system --",
    "postinstall": "node packages/design-system/scripts/build.mjs --soft",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "contentful:compress": "node scripts/contentful/compress.mjs",
    "contentful:apply": "node scripts/contentful/apply.mjs",
    "contentful:push": "node scripts/contentful/push.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.110",
    "@jobzeug/design-system": "*",
    "@mastra/ai-sdk": "^1.10.3",
    "@mastra/core": "^1.67.0",
    "@mastra/loggers": "^1.3.2",
    "@mastra/memory": "^1.30.0",
    "@mastra/pg": "^1.25.0",
    "ai": "^7.0.107",
    "contentful": "^11.12.10",
    "contentful-management": "^12.17.0",
    "mastra": "^1.30.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  }
}
