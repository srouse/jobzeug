{
  "name": "@jobzeug/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jobzeug design system — Lit web components + CSS tokens",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "react-server": "./dist/react/react-server.js",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./tokens.css": "./dist/designSystem/tokens.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/react/index.js",
    "./dist/designSystem/tokens.css"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepare": "node ./scripts/build.mjs",
    "dev": "vite build --watch",
    "tokens:emit": "ds2 tokens emit --formats all",
    "ds2": "ds2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@lit/react": "^1.0.7",
    "@vanilla-extract/css": "^1.21.2",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@contentful/design-system-squared-agent-kit": "file:../../../d2s-design-system-squared/packages/cli",
    "@types/react": "^19",
    "@vanilla-extract/vite-plugin": "^5.1.2",
    "react": "19.2.8",
    "typescript": "^5",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
